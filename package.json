{
  "name": "unison",
  "productName": "Unison",
  "version": "0.2.0",
  "private": true,
  "description": "Spotify, SoundCloud and local files in one window",
  "main": "./out/main/index.js",
  "author": "tripp",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "cross-env ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs run",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "dist": "npm run typecheck && cross-env UNISON_RELEASE=1 electron-vite build && electron-builder --win",
    "release": "npm run typecheck && cross-env UNISON_RELEASE=1 electron-vite build && electron-builder --win --publish always",
    "dist:dir": "npm run typecheck && cross-env UNISON_RELEASE=1 electron-vite build && electron-builder --win --dir",
    "smoke": "electron-vite build && node scripts/smoke.mjs",
    "vmp:sign": "python -m castlabs_evs.vmp sign-pkg node_modules/electron/dist"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@xhayper/discord-rpc": "^1.5.1",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^6.0.0",
    "electron-updater": "^6.8.11",
    "music-metadata": "^12.3.5"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-virtual": "^3.14.26",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-env": "^10.1.0",
    "discord-api-types": "^0.38.58",
    "electron": "github:castlabs/electron-releases#v45.2.1+wvcus",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "hls.js": "^1.7.4",
    "lucide-react": "^1.70.0",
    "motion": "^14.11.1",
    "playwright-core": "^1.65.0",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.1.0",
    "zustand": "^5.1.0"
  }
}
